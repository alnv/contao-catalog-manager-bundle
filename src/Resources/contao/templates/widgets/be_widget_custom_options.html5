<?php

use Contao\StringUtil;

$strFieldId = 'ctrl_' . $this->id;
$strRootId = 'cm-ow-root-' . $this->id;
?>
<div id="<?= StringUtil::specialchars($strRootId) ?>" class="cm-ow-root">
    <custom-option-wizard-field
        :no-label="true"
        :value="<?= $this->value ?>"
        :eval="<?= htmlspecialchars(json_encode($this->attributes, JSON_PARTIAL_OUTPUT_ON_ERROR), ENT_QUOTES, 'UTF-8') ?>"
        name="<?= StringUtil::specialchars($this->name) ?>"
        id-prefix="<?= StringUtil::specialchars($strFieldId) ?>"
    ></custom-option-wizard-field>
</div>
<script data-turbo="false">
    (function () {
        var rootId = <?= json_encode($strRootId, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT) ?>;

        function mount() {
            var el = document.getElementById(rootId);

            if (!el || el.__vue__ || typeof Vue === 'undefined') {
                return false;
            }

            new Vue({el: el});
            return true;
        }

        if (!mount()) {
            document.addEventListener('DOMContentLoaded', mount, {once: true});
        }
    })();
</script>
