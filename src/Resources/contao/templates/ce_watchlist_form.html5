<?php use Contao\StringUtil; ?>
<?php $jsonFlags = JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT; ?>
<div id="wishlist-<?= StringUtil::specialchars($this->id) ?>" class="ce_watchlist-component">
    <watchlist-form
            data="<?= StringUtil::specialchars($this->data) ?>"
            :units="<?= (int) $this->units ?>"
            :added="<?= $this->added ? 'true' : 'false' ?>"
            :use-units="<?= $this->useUnits ? 'true' : 'false' ?>"
            request-token="<?= StringUtil::specialchars((string) $this->requestToken) ?>"
            item-title="<?= StringUtil::specialchars(StringUtil::decodeEntities((string) $this->itemTitle)) ?>"
            button-add-label="<?= StringUtil::specialchars((string) $this->buttonAddLabel) ?>"
            button-remove-label="<?= StringUtil::specialchars((string) $this->buttonRemoveLabel) ?>"
            :labels="<?= StringUtil::specialchars(json_encode((object) ($this->labels ?: []), $jsonFlags)) ?>"
    ></watchlist-form>
    <noscript><p class="cm-watchlist__noscript"><?= StringUtil::specialchars($GLOBALS['TL_LANG']['MSC']['cmWatchlist']['noscript'] ?? 'Für die Merkliste wird JavaScript benötigt.') ?></p></noscript>
</div>
<script>
    (function () {
        new Vue({el: <?= json_encode('#wishlist-' . $this->id, $jsonFlags) ?>});
    })();
</script>
