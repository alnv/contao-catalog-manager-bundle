<?php
use Contao\Environment;
use Contao\StringUtil;
use Alnv\ContaoTranslationManagerBundle\Library\Translation;

// Werte für URLs: Tags/Entities entfernen, URL-kodieren und für das HTML-Attribut escapen
$cmShareText = static fn ($v): string => trim(StringUtil::decodeEntities(strip_tags(is_array($v) ? implode(', ', array_filter($v, 'is_scalar')) : (string) $v)));
$cmShareUrl = rawurlencode((string) Environment::get('uri'));
?>
<div class="cm_share_button facebook">
    <a href="<?= StringUtil::specialchars('https://www.facebook.com/sharer.php?u=' . $cmShareUrl) ?>" target="_blank" rel="noopener noreferrer">
      <div class="social-share-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M18.77 7.46H14.5v-1.9c0-.9.6-1.1 1-1.1h3V.5h-4.33C10.24.5 9.5 3.44 9.5 5.32v2.15h-3v4h3v12h5v-12h3.85l.42-4z"/></svg></div>
      <span class="social-share-label"><?= Translation::getInstance()->get('share.button.facebook') ?></span>
   </a>
</div>