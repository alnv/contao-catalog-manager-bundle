<?php
use Contao\Environment;
use Contao\StringUtil;
use Alnv\ContaoTranslationManagerBundle\Library\Translation;

// Werte für URLs: Tags/Entities entfernen, URL-kodieren und für das HTML-Attribut escapen
$cmShareText = static fn ($v): string => trim(StringUtil::decodeEntities(strip_tags(is_array($v) ? implode(', ', array_filter($v, 'is_scalar')) : (string) $v)));
$cmShareUrl = rawurlencode((string) Environment::get('uri'));
?>
<div class="cm_share_button xing">
   <a href="<?= StringUtil::specialchars('https://www.xing-share.com/app/user?op=share;sc_p=xing-share;url=' . $cmShareUrl) ?>" target="_blank" rel="noopener noreferrer">
      <div class="social-share-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M10.2 9.7l-3-5.4C7.2 4 7 4 6.8 4h-5c-.3 0-.4 0-.5.2v.5L4 10 .4 16v.5c0 .2.2.3.4.3h5c.3 0 .4 0 .5-.2l4-6.6v-.5zM24 .2l-.5-.2H18s-.2 0-.3.3l-8 14v.4l5.2 9c0 .2 0 .3.3.3h5.4s.3 0 .4-.2c.2-.2.2-.4 0-.5l-5-8.8L24 .7V.2z"/></svg></div>
      <span class="social-share-label"><?= Translation::getInstance()->get('share.button.xing') ?></span>
   </a>
</div>