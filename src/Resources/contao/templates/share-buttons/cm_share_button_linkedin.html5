<?php
use Contao\Environment;
use Contao\StringUtil;
use Alnv\ContaoTranslationManagerBundle\Library\Translation;

// Werte für URLs: Tags/Entities entfernen, URL-kodieren und für das HTML-Attribut escapen
$cmShareText = static fn ($v): string => trim(StringUtil::decodeEntities(strip_tags(is_array($v) ? implode(', ', array_filter($v, 'is_scalar')) : (string) $v)));
$cmShareUrl = rawurlencode((string) Environment::get('uri'));
?>
<div class="cm_share_button linkedin">
   <a href="<?= StringUtil::specialchars('https://www.linkedin.com/shareArticle?mini=true&url=' . $cmShareUrl) ?>" target="_blank" rel="noopener noreferrer">
      <div class="social-share-icon"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M6.5 21.5h-5v-13h5v13zM4 6.5C2.5 6.5 1.5 5.3 1.5 4s1-2.4 2.5-2.4c1.6 0 2.5 1 2.6 2.5 0 1.4-1 2.5-2.6 2.5zm11.5 6c-1 0-2 1-2 2v7h-5v-13h5V10s1.6-1.5 4-1.5c3 0 5 2.2 5 6.3v6.7h-5v-7c0-1-1-2-2-2z"/></svg></div>
      <span class="social-share-label"><?= Translation::getInstance()->get('share.button.linkedin') ?></span>
   </a>
</div>